### --- Set up Dataloader (so we can call multiple pictures/data easier) --- ###

class MarsDataset(Dataset):
    def __init__(self, txt_file, root_dir, transform=None):
        self.root_dir = root_dir #root path
        self.transform = transform
        
        with open(txt_file, "r") as f:
            self.samples = [line.strip().split() for line in f] #reads and breaks down each image title to find what it's labels as and so on - the last number in the JPG title is what image category it is. 

    def __len__(self):
        return len(self.samples) #computes epoch sizes, batch counts, ect. 

    def __getitem__(self, idx): #part of PyTorch -> gets the path and label 
        img_path, label = self.samples[idx]
        full_path = os.path.join(self.root_dir, img_path)

        image = Image.open(full_path).convert("RGB")
        label = int(label) #converts label to integer 

        if self.transform:
            image = self.transform(image) #cleans/transform image if need me

        return image, label #call to return the sample


