### --- First CNN using SimpleCNN (also from PyTorch)--- ###

class SimpleCNN(nn.Module):
    def __init__(self, num_classes=25): #matches terrian labels 
        super().__init__()

        self.features = nn.Sequential( #where the model learns visual pattern 
            nn.Conv2d(3, 32, 3, padding=1), #fist convolution to find basic patterns 
            nn.ReLU(),
            nn.MaxPool2d(2),

            nn.Conv2d(32, 64, 3, padding=1), #second convolution to find high-level patterns (like shapes and rocks)
            nn.ReLU(),
            nn.MaxPool2d(2),

            nn.Conv2d(64, 128, 3, padding=1), #third convolution - summarizes the image 
            nn.ReLU(),
            nn.AdaptiveAvgPool2d((1, 1))
        )

        self.classifier = nn.Linear(128, num_classes) #classifer 

    def forward(self, x): #forward pass
        x = self.features(x)
        x = x.view(x.size(0), -1)
        return self.classifier(x)


